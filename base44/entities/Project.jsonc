{
  "name": "Project",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string",
      "title": "Organization"
    },
    "departmentId": {
      "type": "string",
      "title": "Department"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "ACTIVE",
        "AT_RISK",
        "DELAYED",
        "COMPLETED",
        "ARCHIVED"
      ],
      "default": "PLANNED",
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium",
      "title": "Priority"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "leadId": {
      "type": "string",
      "title": "Project Lead"
    },
    "principalInvestigator": {
      "type": "string",
      "title": "Principal Investigator"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Members"
    },
    "fundingSource": {
      "type": "string",
      "title": "Funding Source"
    },
    "budget": {
      "type": "number",
      "title": "Budget"
    },
    "progressPercent": {
      "type": "number",
      "default": 0,
      "title": "Progress Percent"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Low",
      "title": "Risk Level"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Tags"
    }
  },
  "required": [
    "name",
    "organizationId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "data.members": "{{user.id}}"
                },
                {
                  "data.leadId": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "data.members": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                },
                {
                  "data.leadId": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}