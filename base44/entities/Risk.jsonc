{
  "name": "Risk",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "projectId": {
      "type": "string",
      "title": "Project"
    },
    "level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Medium",
      "title": "Level"
    },
    "status": {
      "type": "string",
      "enum": [
        "Identified",
        "Monitoring",
        "Mitigating",
        "Resolved",
        "Ignored"
      ],
      "default": "Identified",
      "title": "Status"
    },
    "identifiedBy": {
      "type": "string",
      "title": "Identified By"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "mitigation": {
      "type": "string",
      "title": "Mitigation"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date",
      "title": "Resolved At"
    },
    "relatedTaskIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Related Task IDs"
    }
  },
  "required": [
    "title",
    "projectId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.appRole": "ADMIN"
          }
        },
        {
          "user_condition": {
            "data.appRole": "PI"
          }
        },
        {
          "user_condition": {
            "data.appRole": "TEAM_LEADER"
          }
        },
        {
          "user_condition": {
            "data.appRole": "RESEARCHER"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.appRole": "ADMIN"
          }
        },
        {
          "user_condition": {
            "data.appRole": "PI"
          }
        },
        {
          "user_condition": {
            "data.appRole": "TEAM_LEADER"
          }
        },
        {
          "data.identifiedBy": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.appRole": "ADMIN"
          }
        },
        {
          "user_condition": {
            "data.appRole": "PI"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}