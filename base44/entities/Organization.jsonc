{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "type": {
      "type": "string",
      "enum": [
        "University",
        "Institute",
        "Company",
        "Lab",
        "Government",
        "Other"
      ],
      "default": "University",
      "title": "Type"
    },
    "domain": {
      "type": "string",
      "title": "Domain"
    },
    "logoUrl": {
      "type": "string",
      "title": "Logo URL"
    },
    "country": {
      "type": "string",
      "title": "Country"
    },
    "settings": {
      "type": "object",
      "default": {},
      "title": "Settings"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.data.organizationId}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.appRole": "ADMIN"
          }
        },
        {
          "user_condition": {
            "data.appRole": "PI"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.appRole": "ADMIN"
          }
        },
        {
          "user_condition": {
            "data.appRole": "PI"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.appRole": "ADMIN"
          }
        }
      ]
    }
  }
}