{
  "name": "Activity",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string",
      "title": "Organization"
    },
    "memberId": {
      "type": "string",
      "title": "Member"
    },
    "userId": {
      "type": "string",
      "title": "User"
    },
    "projectId": {
      "type": "string",
      "title": "Project"
    },
    "taskId": {
      "type": "string",
      "title": "Task"
    },
    "type": {
      "type": "string",
      "enum": [
        "FILE_UPLOAD",
        "FILE_UPDATE",
        "TASK_CREATED",
        "TASK_UPDATED",
        "TASK_COMPLETED",
        "EXPERIMENT",
        "MEETING",
        "CODE_COMMIT",
        "DATA_GENERATED",
        "REPORT_CREATED",
        "MANUAL_NOTE",
        "OTHER"
      ],
      "default": "OTHER",
      "title": "Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "title": "Date"
    },
    "durationMinutes": {
      "type": "number",
      "title": "Duration Minutes"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "fileRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "File Refs"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Evidence Refs"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Tags"
    },
    "source": {
      "type": "string",
      "enum": [
        "Manual",
        "Auto",
        "Imported"
      ],
      "default": "Auto",
      "title": "Source"
    },
    "aiSummary": {
      "type": "string",
      "title": "AI Summary"
    }
  },
  "required": [
    "projectId",
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "data.memberId": "{{user.id}}"
                },
                {
                  "data.userId": "{{user.id}}"
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizationId": "{{user.data.organizationId}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "TEAM_LEADER"
                  }
                },
                {
                  "data.memberId": "{{user.id}}"
                },
                {
                  "data.userId": "{{user.id}}"
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "data.memberId": "{{user.id}}"
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}