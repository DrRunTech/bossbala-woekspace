{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string",
      "title": "Organization"
    },
    "userId": {
      "type": "string",
      "title": "User"
    },
    "action": {
      "type": "string",
      "title": "Action"
    },
    "entityType": {
      "type": "string",
      "title": "Entity Type"
    },
    "entityId": {
      "type": "string",
      "title": "Entity ID"
    },
    "changes": {
      "type": "object",
      "default": {},
      "title": "Changes"
    },
    "metadata": {
      "type": "object",
      "default": {},
      "title": "Metadata"
    },
    "ipAddress": {
      "type": "string",
      "title": "IP Address"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Timestamp"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizationId": "{{user.data.organizationId}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "user_condition": {
                "data.appRole": "ADMIN"
              }
            }
          ]
        }
      ]
    }
  }
}