{
  "name": "Task",
  "type": "object",
  "properties": {
    "organizationId": {
      "type": "string",
      "title": "Organization"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "projectId": {
      "type": "string",
      "title": "Project"
    },
    "assigneeId": {
      "type": "string",
      "title": "Assignee"
    },
    "status": {
      "type": "string",
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ],
      "default": "TODO",
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "default": "P2",
      "title": "Priority"
    },
    "type": {
      "type": "string",
      "enum": [
        "Experiment",
        "Simulation",
        "Writing",
        "Reading",
        "Analysis",
        "Meeting",
        "Code",
        "Fabrication",
        "Other"
      ],
      "default": "Other",
      "title": "Type"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "estimatedHours": {
      "type": "number",
      "title": "Estimated Hours"
    },
    "actualHours": {
      "type": "number",
      "title": "Actual Hours"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Tags"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Dependencies"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Evidence Refs"
    },
    "completedAt": {
      "type": "string",
      "format": "date",
      "title": "Completed At"
    }
  },
  "required": [
    "title",
    "projectId",
    "assigneeId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "data.assigneeId": "{{user.id}}"
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "TEAM_LEADER"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "TEAM_LEADER"
                  }
                },
                {
                  "data.assigneeId": "{{user.id}}"
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organizationId": "{{user.data.organizationId}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.appRole": "PI"
                  }
                },
                {
                  "user_condition": {
                    "data.appRole": "ADMIN"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}